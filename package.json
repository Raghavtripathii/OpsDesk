{
  "name": "opsdesk",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:psql": "docker compose exec db psql -U opsdesk -d opsdesk",
    "dev": "npm run dev --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "typecheck": "npm run typecheck --workspace server",
    "worker": "npm run worker --workspace server"
  }
}
